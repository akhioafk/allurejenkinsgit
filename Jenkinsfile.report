pipeline {
    agent any

    stages {
        stage('open artifacts') {
            steps {
                copyArtifacts (
                    projectName: 'asd2',
                    selector: lastCompleted(),
                    filter: 'allure-results/*.*',
                    target: 'allure-results',
                    fingerprintArtifacts: true
                )
            }
        }

        stage ('generate allure report') {
            steps {
                allure includeProperties: false, results: [[path: 'allure-results']]
            }
        }
    }
}